# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres123
DB_NAME=photobooth_db
DB_SSLMODE=disable

# TypeORM / Prisma Connection URL (Used by Next.js Backend / Scripts)
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/photobooth_db?schema=public

# Go Backend API (apps/api)
API_PORT=8080
API_ENV=development
API_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
JWT_SECRET=supersecretjwtkey_change_in_production_1234567890

# Next.js Frontend (apps/web)
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_APP_NAME="Photo Booth Management System"

# PgAdmin (Optional tools)
PGADMIN_EMAIL=admin@photobooth.local
PGADMIN_PASSWORD=admin123
